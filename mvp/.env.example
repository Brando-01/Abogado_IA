# Pega aquí tu clave. Nunca la pongas en public/ ni la subas a GitHub.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
HOST=127.0.0.1
PORT=4173

# Voz: la clave y el ID se quedan en el servidor.
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
# Cambia el modelo si tu cuenta o voz requiere otro compatible.
FISH_AUDIO_MODEL=s2.1-pro-free
# El modelo Free de Fish es para texto a voz. Transcribe con tu clave de Groq.
VOICE_STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3-turbo
